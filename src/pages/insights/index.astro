---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../data/articles';
---
<Layout title="Insights" description="Practical writing by Wade Olcott on Revenue Operations, forecasting, analytics, fintech and sales leadership.">
<section class="wrap page-hero"><p class="eyebrow">Insights</p><h1>Notes from inside<br/>the business.</h1><p class="text-xl">Practical perspectives on Revenue Operations, sales leadership, and the systems and processes that support growth.</p></section>
<section class="section"><div class="wrap"><div class="grid md:grid-cols-2 gap-10">{articles.map(a=><article class="focus border-t border-[#cbd4d8] pt-7"><p class="eyebrow">{a.category} / <time datetime={a.date}>{new Date(a.date+'T12:00:00Z').toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></p><h2 class="text-2xl! mt-3!">{a.title}</h2><p>{a.description}</p><a class="text-link" href={a.originalUrl}>Read original article ↗</a></article>)}</div></div></section>
</Layout>
