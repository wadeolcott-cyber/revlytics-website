---
import '../styles/global.css';
interface Props { title: string; description: string; noindex?: boolean }
const {title,description,noindex=false}=Astro.props;
const links=[['/how-i-work','How I Work'],['/experience','Experience'],['/insights','Insights'],['/about','About']];
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | RevLytics</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>{noindex&&<meta name="robots" content="noindex"/>}<meta property="og:type" content="website"/><meta property="og:site_name" content="RevLytics"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/images/social-card.png',Astro.site)}/><meta property="og:image:alt" content="RevLytics — Fractional Revenue Operations Leadership"/><meta name="theme-color" content="#152d40"/></head><body><a class="skip" href="#main">Skip to content</a><header class="wrap flex h-[100px] items-center justify-between border-b border-[#dce1e1]"><a class="brand" href="/" aria-label="RevLytics home">Rev<span>Lytics</span><span aria-hidden="true">.</span></a><nav class="hidden md:flex items-center gap-9" aria-label="Main navigation">{links.map(([href,label])=><a class="nav-link" href={href} aria-current={Astro.url.pathname.replace(/\/$/,'')===href?'page':undefined}>{label}</a>)}<a class="button" href="/contact" aria-current={Astro.url.pathname==='/contact'?'page':undefined}>Let's Talk <span aria-hidden="true">↗</span></a></nav><details class="md:hidden"><summary aria-label="Open navigation menu">Menu <span aria-hidden="true">☰</span></summary><nav class="mobile-nav" aria-label="Mobile navigation">{links.map(([href,label])=><a href={href}>{label}</a>)}<a href="/contact">Let's Talk ↗</a></nav></details></header><main id="main"><slot/></main><footer><div class="wrap flex flex-col gap-6 md:flex-row md:items-center md:justify-between"><div><a class="brand" href="/">Rev<span>Lytics</span>.</a><p class="mt-2">Experienced leadership. Personal commitment.</p></div><nav class="flex flex-wrap gap-6 text-sm" aria-label="Footer navigation"><a href="/how-i-work">How I Work</a><a href="/experience">Experience</a><a href="/insights">Insights</a><a href="/about">About</a><a href="/contact">Contact</a></nav><p>© {new Date().getFullYear()} RevLytics</p></div></footer></body></html>
